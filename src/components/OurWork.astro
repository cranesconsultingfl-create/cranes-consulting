---
// Real relationships only. Alexander² is co-owned, so it is labeled as our own company, not a client.
const work = [
  {
    name: 'Alexander² Construction',
    url: 'https://www.a2constructionfl.com/',
    host: 'a2constructionfl.com',
    logo: '/work/alexander2-wordmark.svg',
    logoClass: 'h-5 w-auto',
    logoWidth: 81,
    logoHeight: 9,
    tag: 'Our own general contractor',
    listLabel: 'What we run for A2',
    body: 'Tyler and Collin co-own this custom home builder in Naples, Marco Island and Tampa Bay (Florida license CBC1266523). Every system we teach runs on these jobs first.',
    did: [
      { lane: 'Money Audit', text: 'Traced six lender draws on a Naples build to the bank, the subs and QuickBooks, and turned the gaps into a dated open-items list.' },
      { lane: 'Margin', text: 'Leveled sub bids by trade on a Marco Island custom home before pricing it, comparing each unit price to our last build to find the line items worth negotiating.' },
      { lane: 'Office time', text: 'A client selections app for 349 finish items and a stone picker built from the architect’s rendering, so owner decisions land in writing, not in a text thread.' },
      { lane: 'Software Adoption', text: 'One Drive folder structure on every job, plus lead and call tracking in Google Analytics on the website.' },
      { lane: 'Local search', text: 'SEO for the Naples, Marco Island and Tampa Bay pages, and directory listings like BuildZoom corrected to show the active license.' },
    ],
  },
  {
    name: 'Action Bass Guide Service',
    url: 'https://actionbassguides.com/',
    host: 'actionbassguides.com',
    logo: '/work/action-bass-mark.svg',
    logoClass: 'h-11 w-11',
    logoWidth: 64,
    logoHeight: 64,
    label: 'Action Bass',
    tag: 'Client: software adoption, office time and local search',
    listLabel: 'What we did',
    body: "Captain Jackson Williams runs guided bass fishing trips around Orlando, Kissimmee and Winter Haven. He's on the water most mornings, not at a desk, which is the same problem our subs have.",
    did: [
      { lane: 'Software Adoption', text: 'Set up online booking through Vally and Google Analytics, with every lead, call, text and booking click tracked so he can see what brings in trips.' },
      { lane: 'Office time', text: 'Call, Text and Book buttons on every page, so trips get booked while he is on the water instead of waiting on a callback.' },
      { lane: 'Margin', text: 'A Google Ads plan with a break-even rule: an ad stays on only if it books a trip for less than the 15 to 20% a booking marketplace takes.' },
      { lane: 'Local search', text: 'Rebuilt the website with pages for Lake Toho, Lake Kissimmee, the Winter Haven Chain, Orlando and Kissimmee.' },
      { lane: 'Hand off', text: 'An editor guide and a fishing report template, so his team can update the site without us.' },
    ],
  },
];
---
<section class="border-b border-navy-100" aria-labelledby="our-work">
  <div class="container-x py-20 md:py-24">
  <div class="max-w-2xl">
    <span class="eyebrow">Our work</span>
    <h2 id="our-work" class="mt-5 text-3xl md:text-4xl font-extrabold text-balance leading-[1.1]">
      Built on our own jobs first.
    </h2>
  </div>

  <div class="mt-12 grid lg:grid-cols-2 gap-6">
    {work.map((w) => (
      <a href={w.url} class="card p-7 md:p-8 group flex flex-col">
        <div class="h-12 flex items-center gap-3">
          <img src={w.logo} alt="" width={w.logoWidth} height={w.logoHeight} class={w.logoClass} loading="lazy" decoding="async" />
          {'label' in w && <span class="font-bold text-navy-800">{w.label}</span>}
        </div>
        <p class="mt-6 text-xs font-semibold uppercase tracking-[0.18em] text-amber-700">{w.tag}</p>
        <h3 class="mt-2 text-xl font-bold text-navy-800 group-hover:text-amber-700 transition-colors">{w.name}</h3>
        <p class="mt-3 text-sm text-ink-soft leading-relaxed">{w.body}</p>
        {'did' in w && (
          <div class="flex-1">
            <p class="mt-6 text-xs font-semibold uppercase tracking-[0.18em] text-navy-700">{w.listLabel}</p>
            <ul class="mt-3 space-y-3">
              {w.did.map((d) => typeof d === 'string' ? (
                <li class="flex items-start gap-2.5 text-sm text-ink-soft leading-relaxed">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="text-amber-600 mt-1 shrink-0" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                  {d}
                </li>
              ) : (
                <li class="text-sm text-ink-soft leading-relaxed">
                  <span class="label-chip mr-2 whitespace-nowrap">{d.lane}</span>{d.text}
                </li>
              ))}
            </ul>
          </div>
        )}
        <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-amber-700">
          {w.host}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </span>
      </a>
    ))}
  </div>
  </div>
</section>
