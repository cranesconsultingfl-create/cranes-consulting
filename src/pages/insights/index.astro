---
import Base from '../../layouts/Base.astro';

const posts = [
  {
    href: '/insights/certificate-of-insurance-gc-checklist/',
    title: 'What a GC Checks on Your Certificate of Insurance',
    summary: "Why general contractors reject subcontractor certificates of insurance, what they look for, and one email that gets the right certificate from your agent.",
    category: 'Paperwork',
    read: '5 min read',
    date: 'October 2026',
  },
  {
    href: '/insights/hurricane-delay-notice/',
    title: 'Hurricane Delay Notices for Florida Subcontractors',
    summary: "How to send a written delay notice when a storm stops work: what to include, when to send it, and an AI prompt that drafts it in two minutes.",
    category: 'Getting Paid',
    read: '5 min read',
    date: 'October 2026',
  },
  {
    href: '/insights/pay-app-approved-first-time/',
    title: 'How to Get Your Pay App Approved the First Time',
    summary: "Why GCs bounce subcontractor pay applications, a first-submission checklist, and AI prompts that catch the problems before you hit send.",
    category: 'Getting Paid',
    read: '6 min read',
    date: 'October 2026',
  },
  {
    href: '/insights/ai-adoption-playbook/',
    title: 'The Small Business AI Adoption Playbook',
    summary: "A five-step plan for getting real hours back from ChatGPT, Claude, and Copilot: find the right workflows, set guardrails, train by role, and measure what it saves.",
    category: 'AI & Automation',
    read: '5 min read',
    date: 'September 2026',
  },
  {
    href: '/insights/shelfware-software-audit/',
    title: 'The Shelfware Construction Software Audit',
    summary: "A 10-question audit for small GCs paying $6–12K/year for Procore, Buildertrend, or JobTread but only using a fraction of what they bought. Diagnose the gap in 20 minutes.",
    category: 'Software & Tech',
    read: '9 min read',
    date: 'April 2026',
  },
  {
    href: '/insights/margin-leak-checklist/',
    title: 'The Small Contractor Margin Leak Checklist',
    summary: "Seven operating pains quietly costing a $5M contractor two points of net margin every year. Each one has a 30-day fix.",
    category: 'Operations',
    read: '8 min read',
    date: 'April 2026',
  },
  {
    href: '/insights/cdbg-dr-readiness-guide/',
    title: 'CDBG-DR Contractor Readiness Guide',
    summary: "What small Tampa GCs need to have in place before bidding federally-funded Helene / Milton rebuild work, and the three mistakes that stop payment.",
    category: 'Grants & Compliance',
    read: '10 min read',
    date: 'April 2026',
  },
];
---
<Base
  title="Operations Insights for Small Businesses | Cranes Consulting"
  description="Field notes on paperwork, getting paid and AI for subcontractors and small businesses in Tampa Bay and Naples."
>
  <section class="border-b border-navy-100">
    <div class="container-x py-20 md:py-24">
      <span class="eyebrow">Insights</span>
      <h1 class="mt-6 max-w-4xl text-4xl md:text-5xl lg:text-[56px] font-extrabold tracking-tightest text-balance leading-[1.05] text-navy-900">
        Field notes from small-business operations.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-soft leading-relaxed">
        Short, specific, and written to be useful without a sales call. If you find yourself referencing one back to a team member, that's the goal.
      </p>
    </div>
  </section>

  <section class="container-x py-20 md:py-24 grid md:grid-cols-2 gap-6">
    {posts.map((p, i) => (
      <a href={p.href} class:list={['card p-8 group flex flex-col', i === 0 && posts.length % 2 === 1 && 'md:col-span-2']}>
        <div class="flex items-center gap-3">
          <span class="label-chip">{p.category}</span>
          <span class="text-xs text-ink-mute">{p.read} · {p.date}</span>
        </div>
        <h2 class="mt-5 text-xl md:text-2xl font-bold text-navy-800 group-hover:text-amber-700 transition-colors">{p.title}</h2>
        <p class="mt-3 text-sm text-ink-soft leading-relaxed flex-1">{p.summary}</p>
        <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-amber-700">
          Read more
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </span>
      </a>
    ))}
  </section>
</Base>
