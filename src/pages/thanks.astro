---
import Base from '../layouts/Base.astro';
---
<Base
  title="Message Received | Cranes Consulting"
  description="Thanks for reaching out to Cranes Consulting. We reply within one business day."
  noindex
>
  <section class="container-x py-24 md:py-32">
    <span class="eyebrow">Message received</span>
    <h1 class="mt-6 max-w-3xl text-4xl md:text-5xl font-extrabold tracking-tightest text-balance leading-[1.05] text-navy-900">
      Thanks. Your message is in.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-ink-soft leading-relaxed">
      We reply within one business day, usually the same day, from <span class="font-semibold text-navy-800">cranesconsultingfl@gmail.com</span>. If you don't see it, check your spam folder.
    </p>
    <div class="mt-9 flex flex-wrap gap-4">
      <a href="/insights/" class="btn-primary">Read the field notes</a>
      <a href="/" class="btn-ghost">Back to home</a>
    </div>
  </section>
</Base>
