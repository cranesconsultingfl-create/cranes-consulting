---
import Base from '../../../layouts/Base.astro';
import { packPrompts } from '../../../data/paperwork-pack';
---
<Base
  title="Your Paperwork Pack | Cranes Consulting"
  description="Ten copy-and-paste AI prompts for subcontractor paperwork."
  noindex
>
  <section class="border-b border-navy-100">
    <div class="container-x py-16 md:py-20">
      <span class="eyebrow">Your Paperwork Pack</span>
      <h1 class="mt-6 max-w-4xl text-4xl md:text-5xl font-extrabold tracking-tightest text-balance leading-[1.05] text-navy-900">
        Ten prompts for the paperwork GCs judge you on.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-soft leading-relaxed">
        Bookmark this page. Tap <strong class="text-navy-800">Copy</strong>, paste into ChatGPT, Claude, Copilot or Gemini, and replace everything in [brackets]. On your phone, use the microphone to dictate the details.
      </p>

      <div class="mt-8 max-w-3xl rounded-xl bg-amber-50 border border-amber-200 p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-800">Before you start</p>
        <ul class="mt-3 space-y-2 text-sm text-navy-800 leading-relaxed list-disc pl-5">
          <li>Never paste bank account numbers, Social Security numbers or passwords into an AI tool.</li>
          <li>Read every draft before you send it. You're responsible for what goes out under your name.</li>
          <li>Lien waivers, notices to owner and contract terms have legal wording and deadlines under Florida law (Chapter 713). Use AI to organize and draft, then use the GC's required forms and check with your attorney.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="container-x py-16 md:py-20">
    <ol class="space-y-8 max-w-4xl">
      {packPrompts.map((p, i) => (
        <li id={p.id} class="card p-6 md:p-8 scroll-mt-28">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-mono text-xs text-amber-700 font-bold tracking-widest">{String(i + 1).padStart(2, '0')}</p>
              <h2 class="mt-2 text-xl md:text-2xl font-bold">{p.title}</h2>
              <p class="mt-1 text-sm text-ink-mute">{p.when}</p>
            </div>
            <button type="button" class="btn-ghost shrink-0 !px-4 !py-2" data-copy={p.id} aria-label={`Copy prompt: ${p.title}`}>Copy</button>
          </div>
          <pre id={`prompt-${p.id}`} class="mt-5 whitespace-pre-wrap rounded-lg bg-bone-200/70 border border-navy-100 p-5 text-sm leading-relaxed text-ink-soft font-sans">{p.prompt}</pre>
        </li>
      ))}
    </ol>

    <div class="mt-16 max-w-4xl rounded-2xl bg-navy-900 text-white px-8 py-12 md:px-12">
      <h2 class="text-2xl md:text-3xl font-extrabold text-white text-balance leading-[1.1]">Want these set up on your own jobs?</h2>
      <p class="mt-3 text-navy-100 text-lg max-w-2xl">AI Office Training turns these into templates built around your trade, your GCs and your tools, and teaches you to run them in minutes. Start with a free 30-minute call.</p>
      <div class="mt-7 flex flex-wrap gap-4">
        <a href="/contact/" class="btn-accent">Book a free 30-min call</a>
        <a href="/services/#money-audit" class="btn-ghost !border-navy-600 !text-white hover:!bg-navy-800">See the Money Audit</a>
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const pre = document.getElementById(`prompt-${btn.dataset.copy}`);
      if (!pre) return;
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        btn.textContent = 'Copied';
      } catch {
        const range = document.createRange();
        range.selectNodeContents(pre);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        btn.textContent = 'Selected';
      }
      setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
    });
  });
</script>
