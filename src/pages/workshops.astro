---
import Base from '../layouts/Base.astro';

const covers = [
  { t: 'Change orders signed before the work', d: 'Turn a voice memo from the job site into a one-page change order the GC can sign the same day.' },
  { t: 'Pay apps approved the first time', d: 'The backup GCs actually check, and an AI checklist that catches what is missing before you hit send.' },
  { t: 'Insurance that never lapses', d: 'Request the right certificate from your agent in one message, and track expiration dates without a spreadsheet.' },
  { t: 'Answers in two minutes, not two days', d: 'Reply to GCs and customers from the truck, professional and specific, without sounding like a robot.' },
];

const formats = [
  { t: 'Lunch-and-learn', d: '45 to 60 minutes at your office, chapter meeting or branch counter.' },
  { t: 'Hands-on session', d: '90 minutes. Attendees bring their phone and leave with one real change order or pay app email drafted.' },
  { t: 'Virtual', d: '60 minutes on Zoom or Teams for members who cannot leave the job.' },
];
---
<Base
  title="Free AI Paperwork Workshop for Contractors | Cranes Consulting"
  description="Book a free Get Paid Faster workshop for your association, supply house, chamber or subcontractor base in Tampa Bay or Naples. AI for change orders, pay apps and insurance."
>
  <section class="border-b border-navy-100">
    <div class="container-x py-20 md:py-24">
      <span class="eyebrow">Workshops</span>
      <h1 class="mt-6 max-w-4xl text-4xl md:text-5xl lg:text-[56px] font-extrabold tracking-tightest text-balance leading-[1.05] text-navy-900">
        Get Paid Faster: a free AI workshop for your members.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-soft leading-relaxed">
        For trade associations, supply houses, chambers and general contractors in Tampa Bay and Naples who want their subs to spend less time in the office and more time on the job. Taught from the GC's side of the desk, with live AI demos on real paperwork.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href="#request" class="btn-accent">Request a workshop</a>
        <a href="/paperwork-pack/" class="btn-ghost">See the Paperwork Pack attendees get</a>
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-24 grid lg:grid-cols-12 gap-12">
    <div class="lg:col-span-4">
      <span class="eyebrow">What we cover</span>
      <h2 class="mt-5 text-3xl md:text-4xl font-extrabold leading-[1.1]">The four pieces of paperwork that decide who gets paid.</h2>
    </div>
    <div class="lg:col-span-8 grid sm:grid-cols-2 gap-5">
      {covers.map((c) => (
        <div class="card p-6">
          <h3 class="text-lg font-bold text-navy-800">{c.t}</h3>
          <p class="mt-2 text-sm text-ink-soft leading-relaxed">{c.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-bone-200/60 border-y border-navy-100">
    <div class="container-x py-20 md:py-24 grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-4">
        <span class="eyebrow">Formats</span>
        <h2 class="mt-5 text-3xl md:text-4xl font-extrabold leading-[1.1]">Fits your calendar.</h2>
        <p class="mt-5 text-ink-soft leading-relaxed">
          Every attendee gets the free GC-Approved Paperwork Pack: ten copy-and-paste AI prompts they can use the same day.
        </p>
      </div>
      <div class="lg:col-span-8 grid md:grid-cols-3 gap-5">
        {formats.map((f) => (
          <div class="card p-6">
            <h3 class="text-lg font-bold text-navy-800">{f.t}</h3>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">{f.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-24 grid lg:grid-cols-12 gap-12">
    <div class="lg:col-span-5">
      <span class="eyebrow">Who teaches it</span>
      <h2 class="mt-5 text-3xl md:text-4xl font-extrabold leading-[1.1]">Tyler Alexander</h2>
      <p class="mt-5 text-ink-soft leading-relaxed">
        Founder of Cranes Consulting and co-owner of <a href="https://www.a2constructionfl.com/" class="text-amber-700 underline decoration-amber-400/60 underline-offset-4">Alexander² Construction</a>, a general contractor building in Tampa and Naples. Lean Six Sigma Black Belt and PMP with 10+ years running enterprise programs. He reviews subs' paperwork on every build, so the workshop shows what actually gets approved, not theory.
      </p>
    </div>

    <div id="request" class="lg:col-span-7 scroll-mt-28">
      <div class="card p-7">
        <h2 class="text-xl font-bold">Request a workshop</h2>
        <p class="mt-2 text-sm text-ink-soft">We reply within one business day to pick a date.</p>
        <form
          name="workshop-request"
          method="POST"
          action="/thanks/"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="mt-6 space-y-4"
        >
          <input type="hidden" name="form-name" value="workshop-request" />
          <p class="hidden"><label>Don't fill this out if you're human: <input name="bot-field" /></label></p>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="ws-name" class="block text-sm font-medium text-navy-800 mb-1.5">Your name</label>
              <input id="ws-name" name="name" type="text" required autocomplete="name" class="w-full rounded-md border border-navy-200 bg-white px-4 py-3 text-sm focus:border-navy-800 focus:outline-none focus:ring-2 focus:ring-navy-800/20" />
            </div>
            <div>
              <label for="ws-org" class="block text-sm font-medium text-navy-800 mb-1.5">Organization</label>
              <input id="ws-org" name="organization" type="text" required autocomplete="organization" class="w-full rounded-md border border-navy-200 bg-white px-4 py-3 text-sm focus:border-navy-800 focus:outline-none focus:ring-2 focus:ring-navy-800/20" />
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="ws-email" class="block text-sm font-medium text-navy-800 mb-1.5">Email</label>
              <input id="ws-email" name="email" type="email" required autocomplete="email" class="w-full rounded-md border border-navy-200 bg-white px-4 py-3 text-sm focus:border-navy-800 focus:outline-none focus:ring-2 focus:ring-navy-800/20" />
            </div>
            <div>
              <label for="ws-type" class="block text-sm font-medium text-navy-800 mb-1.5">Type of group</label>
              <select id="ws-type" name="group-type" class="w-full rounded-md border border-navy-200 bg-white px-4 py-3 text-sm focus:border-navy-800 focus:outline-none focus:ring-2 focus:ring-navy-800/20">
                <option>Trade association</option>
                <option>Supply house or distributor</option>
                <option>Chamber or business group</option>
                <option>General contractor (for our subs)</option>
                <option>Other</option>
              </select>
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="ws-size" class="block text-sm font-medium text-navy-800 mb-1.5">Expected attendees</label>
              <input id="ws-size" name="attendees" type="text" inputmode="numeric" class="w-full rounded-md border border-navy-200 bg-white px-4 py-3 text-sm focus:border-navy-800 focus:outline-none focus:ring-2 focus:ring-navy-800/20" />
            </div>
            <div>
              <label for="ws-where" class="block text-sm font-medium text-navy-800 mb-1.5">Where</label>
              <select id="ws-where" name="location" class="w-full rounded-md border border-navy-200 bg-white px-4 py-3 text-sm focus:border-navy-800 focus:outline-none focus:ring-2 focus:ring-navy-800/20">
                <option>Tampa Bay</option>
                <option>Naples / Southwest Florida</option>
                <option>Virtual</option>
              </select>
            </div>
          </div>
          <div>
            <label for="ws-notes" class="block text-sm font-medium text-navy-800 mb-1.5">Anything we should know? <span class="text-ink-mute font-normal">(optional)</span></label>
            <textarea id="ws-notes" name="notes" rows="3" class="w-full rounded-md border border-navy-200 bg-white px-4 py-3 text-sm focus:border-navy-800 focus:outline-none focus:ring-2 focus:ring-navy-800/20"></textarea>
          </div>
          <button type="submit" class="btn-accent">Request the workshop</button>
        </form>
      </div>
    </div>
  </section>
</Base>
