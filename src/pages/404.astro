---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page Not Found | Cranes Consulting"
  description="That page doesn't exist. Find Cranes Consulting services, insights, and contact details here."
  noindex
>
  <section class="container-x py-24 md:py-32">
    <span class="eyebrow">Page not found</span>
    <h1 class="mt-6 max-w-3xl text-4xl md:text-5xl font-extrabold tracking-tightest text-balance leading-[1.05] text-navy-900">
      That page isn't here.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-ink-soft leading-relaxed">
      The link may be old or mistyped. Here's where most people are headed.
    </p>
    <div class="mt-9 flex flex-wrap gap-4">
      <a href="/contact/" class="btn-accent">Get a free 30-min audit</a>
      <a href="/services/" class="btn-ghost">Services</a>
      <a href="/insights/" class="btn-ghost">Insights</a>
      <a href="/" class="btn-ghost">Home</a>
    </div>
  </section>
</Base>
