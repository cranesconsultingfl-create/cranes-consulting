---
import Base from '../layouts/Base.astro';
import { faqSchema } from '../lib/schema';

const services = [
  {
    id: 'money-audit',
    number: '01',
    title: 'Money Audit',
    kicker: 'One Job, Every Dollar Traced',
    body: "We tie every invoice, change order, pay app and payment on a recent job to what actually hit the bank. You see what you're still owed, what never got billed, and the paperwork gaps slowing down your next payment.",
    bullets: ['Invoice-to-bank tie-out', 'Unbilled change orders', 'Released but unpaid funds', 'Top three fixes'],
  },
  {
    id: 'back-office',
    number: '02',
    title: 'AI Office Training',
    kicker: 'We Teach You to Cut Office Time',
    body: "Hands-on training on your real jobs. You learn to use AI to write change orders, pay apps, invoices, insurance requests and follow-ups in minutes instead of evenings, and you keep the skill after we leave.",
    bullets: ['Change orders + pay apps', 'Invoices + follow-ups', 'Insurance + WC tracking', 'Templates and prompts you keep'],
  },
  {
    id: 'software-adoption',
    number: '03',
    title: 'Software Adoption',
    kicker: 'Make What You Bought Actually Work',
    body: "Procore, Buildertrend, JobTread, QuickBooks, HubSpot. Most teams use a fraction of what they pay for. We design the workflow, migrate the data, train the roles, and build the reports that make people want to use it.",
    bullets: ['Workflow design', 'Data migration', 'Role-based training', 'Reporting & dashboards'],
  },
  {
    id: 'margin-recovery',
    number: '04',
    title: 'Margin Recovery',
    kicker: 'Lean Six Sigma DMAIC Sprints',
    body: 'A 90-day engagement going after the points of net margin that hide in labor time, late change orders, material waste, and stale estimating assumptions.',
    bullets: ['Value-stream mapping', 'Standard work + SOPs', 'KPI dashboards', 'Optional gainshare pricing'],
  },
  {
    id: 'fractional-pmo',
    number: '05',
    title: 'Fractional PMO',
    kicker: 'Program Governance on Retainer',
    body: 'For owners running too many initiatives at once. Portfolio visibility, a steering cadence, risk and dependency tracking, and stage-gate reviews at small-business scale.',
    bullets: ['Portfolio dashboard', 'Biweekly steering', 'Risk + dependency mapping', 'Vendor / sub oversight'],
  },
  {
    id: 'grant-programs',
    number: '06',
    title: 'Grant & Rebuild Programs',
    kicker: 'CDBG-DR · FEMA · Federal Compliance',
    body: 'Help navigating Helene and Milton recovery funds and other federal grant work. Davis-Bacon, environmental review, draw schedules, and the audit-ready documentation that gets you paid.',
    bullets: ['Eligibility + readiness', 'Contractor compliance PMO', 'Draw + documentation', 'Closeout support'],
  },
];

const featured = services.slice(0, 2);
const more = services.slice(2);

const industries = [
  { label: 'Subcontractors & Trades', icon: 'construction' },
  { label: 'Professional Services', icon: 'briefcase' },
  { label: 'Healthcare Practices', icon: 'health' },
  { label: 'Logistics & 3PL', icon: 'logistics' },
  { label: 'Government & Nonprofit', icon: 'gov' },
];

const stats = [
  { value: '10+', label: 'Years leading enterprise programs' },
  { value: 'Weekly', label: 'Hiring and managing subs on our own builds' },
  { value: '2', label: 'Markets: Tampa Bay and Naples' },
  { value: 'Fixed', label: 'Fee on every engagement, quoted up front' },
];

const pains = [
  { t: 'Paid late', d: 'The pay app went out without the backup, or not at all, so it sits in someone\'s inbox for another cycle.' },
  { t: 'Paid short', d: 'Extra work got done on a handshake. Without a signed change order, it never makes it onto the invoice.' },
  { t: 'Not called back', d: 'The GC asked twice for a current insurance certificate. Next job, they call the sub who answers the first time.' },
  { t: 'Evenings gone', d: 'Invoices, emails and paperwork at the kitchen table after a full day on the job. Every night.' },
];

const process = [
  {
    n: '01',
    name: 'Listen',
    body: 'A 30-minute call. No deck. We listen for the actual problem, not the symptom you came in with. If we\'re not the right fit, we say so on the call.',
  },
  {
    n: '02',
    name: 'Audit',
    body: 'A money audit on one recent job: every invoice, change order and payment tied to the bank. Without a measured starting point, every claim of improvement is just an opinion.',
  },
  {
    n: '03',
    name: 'Teach',
    body: 'Hands-on AI training on your own jobs, inside the tools you already pay for. We build the templates and prompts with you, not for you, so it sticks.',
  },
  {
    n: '04',
    name: 'Hand off',
    body: 'You finish able to do it yourself: templates, a prompt library, a one-page AI playbook, and fewer evenings at the kitchen table. The goal is no permanent retainer.',
  },
];

// Real, client-approved quotes only (the FTC bans invented testimonials). The section stays hidden while this is empty.
const testimonials: { quote: string; name: string; detail: string }[] = [];

const faqs = [
  {
    q: 'Do you only work with contractors?',
    a: 'No. Subcontractors and trades are our focus because that is the world we work in every week, but the same back office problems show up in any small business: invoices that go out late, approvals that live in text threads, and an owner who is the whole office. If that sounds familiar, we can help.',
  },
  {
    q: 'What does the Money Audit actually find?',
    a: 'We take one recent job and tie every invoice, change order, pay app and payment to the bank. It looks for money you are still owed, work that never got billed, change orders that were never signed, and missing paperwork that slows down payment. It is the fastest way to see what a cleaner back office is worth.',
  },
  {
    q: 'Why does the back office matter so much to GCs and customers?',
    a: 'We co-own Alexander² Construction, a Florida general contractor, so we hire subs every week. The ones who get the next job are not always the best in the field. They are the ones who handle the minutiae: clean pay apps, change orders signed before the work starts, current insurance, and fast answers. Homeowners and business customers judge you the same way.',
  },
  {
    q: 'Do you work in Naples and Southwest Florida?',
    a: 'Yes. We are based in Tampa and also work across Southwest Florida, including Naples, Marco Island, Bonita Springs and Fort Myers. Our construction company builds in both regions, so we are on the ground in each one.',
  },
  {
    q: 'How much do engagements typically cost?',
    a: 'Every engagement is a fixed fee quoted up front. AI Office Training runs $10K to $25K depending on team size and workflows. Software implementations run $15K to $35K. A 90-day Margin Recovery Sprint runs $25K to $50K with optional gainshare. Fractional PMO retainers run $6K to $15K per month. The Money Audit is quoted after the free 30-minute call.',
  },
  {
    q: 'Do you do the paperwork for us?',
    a: 'No. We teach you to do it faster. Most of the people we work with are in the field all day with no office staff, so we show the owner, or whoever helps with the books, how to use AI to draft change orders, pay apps, invoices, insurance requests and follow-ups in minutes. You stay in control, and you are not paying us every month to do it.',
  },
  {
    q: 'Do I need to be good with computers?',
    a: 'No. If you can send a text and an email, you can do this. We train on your phone and the tools you already use, with your own jobs as the examples, and we write down every step so you can repeat it.',
  },
  {
    q: 'Will you work with our existing tools, or do we have to switch?',
    a: 'We work with what you already run: QuickBooks, Procore, Buildertrend, JobTread, Google Workspace, Microsoft 365. We are not in the business of selling you new software.',
  },
];
---
<Base schema={[faqSchema(faqs)]}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-bone-100">
    <div aria-hidden="true" class="absolute inset-0 bg-grid-navy bg-[size:32px_32px] opacity-60 [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)]"></div>

    <div class="container-x relative py-20 md:py-28 lg:py-32">
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <span class="eyebrow">Tampa Bay · Naples · Subs &amp; Small Businesses</span>

          <h1 class="mt-6 text-balance text-4xl md:text-5xl lg:text-[56px] font-extrabold leading-[1.05] tracking-tightest text-navy-900">
            Less time in the office.
            <span class="block text-amber-700">More time on the job.</span>
          </h1>

          <p class="mt-6 max-w-2xl text-lg md:text-xl text-pretty text-ink-soft leading-relaxed">
            Most subcontractors and small business owners are in the field doing the work, with no one in the office to handle the minutiae: change orders, pay apps, invoices, insurance certificates, and the emails that come with them. We teach you to use AI to handle it in a fraction of the time, so you look like the professional company GCs, homeowners and customers want to hire.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a href="/contact/" class="btn-accent">
              Book a free 30-min call
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
            <a href="/paperwork-pack/" class="btn-ghost">
              Get the free Paperwork Pack
            </a>
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-2">
            <span class="label-chip">
              <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
              Lean Six Sigma Black Belt
            </span>
            <span class="label-chip">
              <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
              Florida GC Co-Owner
            </span>
            <span class="label-chip">
              <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
              PMP
            </span>
          </div>
        </div>

        <!-- Visual panel -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl bg-white border border-navy-100 shadow-card-lg overflow-hidden">
            <div class="bg-navy-900 px-6 py-4 flex items-center justify-between">
              <span class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-300">Money Audit Snapshot</span>
              <span class="text-[10px] uppercase tracking-widest text-navy-300">Illustrative</span>
            </div>

            <div class="p-6 space-y-5">
              <div>
                <div class="flex items-baseline justify-between">
                  <p class="text-sm font-medium text-ink-soft">Invoices tied to the bank</p>
                  <p class="text-sm font-semibold text-amber-700">48 of 48</p>
                </div>
                <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-navy-50">
                  <div class="h-full w-full rounded-full bg-gradient-to-r from-amber-400 to-amber-500"></div>
                </div>
              </div>

              <div>
                <div class="flex items-baseline justify-between">
                  <p class="text-sm font-medium text-ink-soft">Change orders signed before work</p>
                  <p class="text-sm font-semibold text-amber-700">5 of 9</p>
                </div>
                <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-navy-50">
                  <div class="h-full w-[56%] rounded-full bg-gradient-to-r from-amber-400 to-amber-500"></div>
                </div>
              </div>

              <div>
                <div class="flex items-baseline justify-between">
                  <p class="text-sm font-medium text-ink-soft">Insurance certificates current</p>
                  <p class="text-sm font-semibold text-amber-700">3 of 4</p>
                </div>
                <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-navy-50">
                  <div class="h-full w-3/4 rounded-full bg-gradient-to-r from-amber-400 to-amber-500"></div>
                </div>
              </div>

              <div class="pt-4 border-t border-navy-100 grid grid-cols-3 gap-3">
                <div>
                  <p class="text-[10px] uppercase tracking-widest text-ink-mute">Owed to you</p>
                  <p class="text-sm font-semibold text-navy-800 mt-1">$11.4K</p>
                </div>
                <div>
                  <p class="text-[10px] uppercase tracking-widest text-ink-mute">Never billed</p>
                  <p class="text-sm font-semibold text-navy-800 mt-1">$6.2K</p>
                </div>
                <div>
                  <p class="text-[10px] uppercase tracking-widest text-ink-mute">Fixes</p>
                  <p class="text-sm font-semibold text-navy-800 mt-1">Top 3</p>
                </div>
              </div>
            </div>
          </div>

          <div class="absolute -bottom-6 -left-6 hidden md:block rounded-xl bg-navy-800 text-white px-5 py-4 shadow-card-lg border border-navy-700">
            <p class="text-[10px] uppercase tracking-widest text-amber-300 font-semibold">Start here</p>
            <p class="mt-1 text-sm font-semibold">Money Audit on one recent job</p>
            <p class="text-xs text-navy-200 mt-0.5">Fixed fee. Every dollar traced.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS STRIP -->
  <section class="bg-navy-900 text-bone-100">
    <div class="container-x py-12 grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.map((s) => (
        <div>
          <p class="text-3xl md:text-4xl font-extrabold tracking-tightest text-amber-300">{s.value}</p>
          <p class="mt-2 text-xs uppercase tracking-[0.18em] text-navy-200">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- TRIGGER -->
  <section class="bg-bone-200/60 border-b border-navy-100">
    <div class="container-x py-20 md:py-28 grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5">
        <span class="eyebrow">Sound familiar?</span>
        <h2 class="mt-5 text-3xl md:text-4xl font-extrabold text-balance leading-[1.1]">
          The work is done. The paperwork isn't.
        </h2>
        <p class="mt-5 text-ink-soft text-lg leading-relaxed">
          You spend the day in the field doing the work. There's no one in the office to write up the change order, send the pay app with the backup, renew the insurance certificate, or answer the GC's email. So it waits until night, or it doesn't happen.
        </p>
        <a href="/money-leak-calculator/" class="btn-primary mt-7">
          Run your numbers
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="lg:col-span-7 grid sm:grid-cols-2 gap-5">
        {pains.map((x) => (
          <div class="card p-6">
            <h3 class="text-lg font-bold text-navy-800">{x.t}</h3>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">{x.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VALUE PROP -->
  <section class="container-x py-20 md:py-28">
    <div class="grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5">
        <span class="eyebrow">Why work with us</span>
        <h2 class="mt-5 text-3xl md:text-4xl font-extrabold text-balance leading-[1.1]">
          We hire subs every week. We know what wins the next job.
        </h2>
      </div>
      <div class="lg:col-span-7 grid sm:grid-cols-2 gap-6">
        <div class="card p-6">
          <div class="h-10 w-10 rounded-lg bg-amber-100 text-amber-600 grid place-items-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg>
          </div>
          <h3 class="mt-4 text-lg font-bold">Built by a contractor</h3>
          <p class="mt-2 text-sm text-ink-soft leading-relaxed">
            We co-own <a href="https://www.a2constructionfl.com/" class="text-amber-700 underline decoration-amber-400/60 underline-offset-4 hover:decoration-amber-500">Alexander² Construction</a>, a Florida general contractor building in Tampa and Naples. We see from the GC's side which subs get called back, and it's rarely about price.
          </p>
        </div>
        <div class="card p-6">
          <div class="h-10 w-10 rounded-lg bg-amber-100 text-amber-600 grid place-items-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 12h8M8 8h8M8 16h5"/></svg>
          </div>
          <h3 class="mt-4 text-lg font-bold">From the GC's side of the desk</h3>
          <p class="mt-2 text-sm text-ink-soft leading-relaxed">
            We review subs' change orders, pay apps and insurance certificates on our own builds. We teach you to send them the way a GC approves them the first time.
          </p>
        </div>
        <div class="card p-6">
          <div class="h-10 w-10 rounded-lg bg-amber-100 text-amber-600 grid place-items-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 2v20M2 12h20"/></svg>
          </div>
          <h3 class="mt-4 text-lg font-bold">We teach. You keep it.</h3>
          <p class="mt-2 text-sm text-ink-soft leading-relaxed">
            We don't take over your office. We teach you to use AI inside the tools you already pay for, so the skill stays with you after we leave.
          </p>
        </div>
        <div class="card p-6">
          <div class="h-10 w-10 rounded-lg bg-amber-100 text-amber-600 grid place-items-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          </div>
          <h3 class="mt-4 text-lg font-bold">Defined start and end</h3>
          <p class="mt-2 text-sm text-ink-soft leading-relaxed">
            Fixed fees and clear deliverables, quoted up front. Scope changes, we re-scope. Nobody gets stuck on an open-ended retainer.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="bg-bone-200/60 border-y border-navy-100">
    <div class="container-x py-20 md:py-28">
      <div class="max-w-2xl">
        <span class="eyebrow">Services</span>
        <h2 class="mt-5 text-3xl md:text-4xl font-extrabold text-balance leading-[1.1]">
          Start with the money. Then win back your evenings.
        </h2>
        <p class="mt-4 text-ink-soft text-lg">
          Free call, then a Money Audit on one job, then AI Office Training. Not ready to talk? Start with the free Paperwork Pack.
        </p>
      </div>

      <div class="mt-12 grid md:grid-cols-2 gap-6">
        {featured.map((s) => (
          <a href={`/services/#${s.id}`} class="card p-7 group block">
            <div class="flex items-start justify-between gap-6">
              <div>
                <p class="font-mono text-xs text-amber-700 font-bold tracking-widest">{s.number}</p>
                <h3 class="mt-2 text-xl md:text-2xl font-bold">{s.title}</h3>
                <p class="mt-1 text-xs uppercase tracking-[0.18em] text-ink-mute font-semibold">{s.kicker}</p>
              </div>
              <span class="h-9 w-9 shrink-0 rounded-full border border-navy-200 text-navy-700 grid place-items-center group-hover:bg-navy-800 group-hover:border-navy-800 group-hover:text-white transition-colors">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </span>
            </div>
            <p class="mt-5 text-sm text-ink-soft leading-relaxed">{s.body}</p>
            <ul class="mt-4 grid grid-cols-2 gap-2">
              {s.bullets.map((b) => (
                <li class="flex items-start gap-2 text-xs text-ink-soft">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="text-amber-600 mt-0.5 shrink-0"><path d="m5 12 5 5L20 7"/></svg>
                  {b}
                </li>
              ))}
            </ul>
          </a>
        ))}
      </div>

      <div class="mt-8 rounded-xl border border-navy-100 bg-white/60 p-6 flex flex-col md:flex-row md:items-center gap-4 md:gap-8">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-navy-700 shrink-0">Also available</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {more.map((s) => (
            <li><a href={`/services/#${s.id}`} class="font-medium text-navy-800 underline decoration-navy-200 underline-offset-4 hover:decoration-amber-500">{s.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="container-x py-20 md:py-28">
    <div class="max-w-2xl">
      <span class="eyebrow">Industries we work with</span>
      <h2 class="mt-5 text-3xl md:text-4xl font-extrabold text-balance leading-[1.1]">
        Trades first. Any small business that runs on paperwork.
      </h2>
    </div>

    <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {industries.map((i) => (
        <div class="card p-6 text-center">
          <div class="mx-auto h-10 w-10 rounded-lg bg-navy-50 text-navy-700 grid place-items-center">
            {i.icon === 'construction' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 20h16M6 20V9l6-4 6 4v11M10 20v-6h4v6"/></svg>}
            {i.icon === 'health' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 21s-7-4.5-7-11a5 5 0 0 1 10-1 5 5 0 0 1 10 1c0 6.5-7 11-7 11"/></svg>}
            {i.icon === 'logistics' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 7h13v10H3zM16 10h4l1 3v4h-5"/><circle cx="7" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg>}
            {i.icon === 'briefcase' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>}
            {i.icon === 'gov' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 21h18M5 21V10l7-5 7 5v11M9 21v-6h6v6"/></svg>}
          </div>
          <p class="mt-3 text-sm font-semibold text-navy-800">{i.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PROCESS -->
  <section class="bg-bone-200/60 border-y border-navy-100">
    <div class="container-x py-20 md:py-28">
      <div class="max-w-2xl">
        <span class="eyebrow">How we work</span>
        <h2 class="mt-5 text-3xl md:text-4xl font-extrabold text-balance leading-[1.1]">
          A four-step process. No mystery, no theatrics.
        </h2>
        <p class="mt-4 text-ink-soft text-lg">
          Listen first, audit one real job, build the back office around what it finds, and hand off cleanly.
        </p>
      </div>

      <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-4 gap-5">
        {process.map((step, i) => (
          <div class="card p-7 relative">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs text-amber-700 font-bold tracking-widest">{step.n}</span>
              {i < 3 && (
                <span aria-hidden="true" class="hidden lg:block absolute right-3 top-1/2 -translate-y-1/2 text-navy-200">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </span>
              )}
            </div>
            <h3 class="mt-3 text-xl font-bold text-navy-800">{step.name}</h3>
            <p class="mt-3 text-sm text-ink-soft leading-relaxed">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  {testimonials.length > 0 && (
    <section class="container-x py-20 md:py-28">
      <div class="max-w-2xl">
        <span class="eyebrow">What clients say</span>
        <h2 class="mt-5 text-3xl md:text-4xl font-extrabold text-balance leading-[1.1]">
          Outcomes you can put in a P&amp;L.
        </h2>
        <p class="mt-4 text-ink-soft text-lg">
          We measure success in points of margin recovered, hours saved, and software actually being used. The work shows up in your numbers.
        </p>
      </div>

      <div class="mt-12 grid md:grid-cols-3 gap-6">
        {testimonials.map((t) => (
          <figure class="card p-7 flex flex-col">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-amber-500" aria-hidden="true"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
            <blockquote class="mt-5 text-ink-soft leading-relaxed flex-1">
              "{t.quote}"
            </blockquote>
            <figcaption class="mt-6 pt-5 border-t border-navy-100">
              <p class="text-sm font-semibold text-navy-800">{t.name}</p>
              <p class="text-xs text-ink-mute mt-0.5">{t.detail}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section>
    <div class="container-x py-20 md:py-28 grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-4">
        <span class="eyebrow">Frequently asked</span>
        <h2 class="mt-5 text-3xl md:text-4xl font-extrabold text-balance leading-[1.1]">
          The questions we get most often.
        </h2>
        <p class="mt-4 text-ink-soft">
          Don't see yours? Email us at <a href="mailto:cranesconsultingfl@gmail.com" class="text-amber-700 underline decoration-amber-400/60 underline-offset-4 hover:decoration-amber-500">cranesconsultingfl@gmail.com</a>.
        </p>
      </div>

      <div class="lg:col-span-8 divide-y divide-navy-100 border-y border-navy-100">
        {faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex items-start justify-between gap-6 cursor-pointer list-none">
              <h3 class="text-lg font-semibold text-navy-800 group-hover:text-amber-700 transition-colors">{f.q}</h3>
              <span class="shrink-0 mt-1 h-6 w-6 rounded-full border border-navy-200 text-navy-700 grid place-items-center group-open:bg-navy-800 group-open:border-navy-800 group-open:text-white transition-colors">
                <svg class="group-open:rotate-45 transition-transform" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
              </span>
            </summary>
            <p class="mt-3 text-sm text-ink-soft leading-relaxed pr-12">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-x py-24">
    <div class="relative overflow-hidden rounded-2xl bg-navy-900 text-white px-8 py-14 md:px-14 md:py-20">
      <div aria-hidden="true" class="absolute -right-24 -bottom-24 h-80 w-80 rounded-full bg-amber-400/10 blur-3xl"></div>
      <div aria-hidden="true" class="absolute -left-16 -top-16 h-60 w-60 rounded-full bg-amber-400/10 blur-3xl"></div>

      <div class="relative max-w-2xl">
        <span class="eyebrow text-amber-300">Next step</span>
        <h2 class="mt-5 text-3xl md:text-4xl font-extrabold text-balance leading-[1.1] text-white">
          30 minutes. No deck. Just the real problem.
        </h2>
        <p class="mt-5 text-navy-100 text-lg">
          Bring something real: a job that didn't pay what it should have, a change order fight, a GC asking for paperwork you don't have. If there's a fit, we'll talk scope. If not, you walk away with two or three fixes you can run with yourself.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/contact/" class="btn-accent">Book a free 30-min call</a>
          <a href="mailto:cranesconsultingfl@gmail.com" class="btn-ghost !border-navy-600 !text-white hover:!bg-navy-800">Email us directly</a>
        </div>
      </div>
    </div>
  </section>
</Base>
