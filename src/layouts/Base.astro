---
import '@fontsource-variable/inter';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { ORG_ID } from '../lib/schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const {
  title = 'AI Office Training for Subs & Small Businesses | Cranes Consulting',
  description = 'Less time in the office, more time on the job. We teach subcontractors and small businesses in Tampa Bay and Naples to use AI for change orders, pay apps and invoices.',
  canonical,
  ogImage = '/og-default.png',
  noindex = false,
  schema = [],
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content="Cranes Consulting" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:site_name" content="Cranes Consulting" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      '@id': ORG_ID,
      name: 'Cranes Consulting',
      description: 'Teaches subcontractors and small businesses in Tampa Bay and Naples to use AI to handle office work: change orders, pay apps, invoices, insurance certificates and follow-ups, so they run like the professional companies GCs, homeowners and customers want to hire.',
      url: Astro.site?.toString(),
      image: new URL('/og-default.png', Astro.site).toString(),
      email: 'cranesconsultingfl@gmail.com',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Tampa',
        addressRegion: 'FL',
        addressCountry: 'US',
      },
      areaServed: ['Tampa', 'St. Petersburg', 'Clearwater', 'Brandon', 'Lakeland', 'Naples', 'Marco Island', 'Bonita Springs', 'Fort Myers'],
      founder: {
        '@type': 'Person',
        name: 'Tyler Alexander',
        worksFor: { '@type': 'GeneralContractor', name: 'Alexander² Construction', url: 'https://www.a2constructionfl.com/' },
      },
      employee: {
        '@type': 'Person',
        name: 'Collin Alexander',
        jobTitle: 'Co-Trainer',
        worksFor: { '@type': 'GeneralContractor', name: 'Alexander² Construction', url: 'https://www.a2constructionfl.com/' },
        hasCredential: { '@type': 'EducationalOccupationalCredential', credentialCategory: 'license', name: 'Florida Certified Building Contractor CBC1266523' },
      },
    })} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-navy-800 focus:px-4 focus:py-2 focus:text-white">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
